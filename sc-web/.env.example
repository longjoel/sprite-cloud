# Local development environment
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/sc_web_dev
AUTH_SECRET=replace-me
AUTH_URL=http://localhost:3000

# Optional TURN/STUN for remote testing
GV_ICE_STUN_URLS=stun:stun.l.google.com:19302
GV_ICE_TURN_URLS=
GV_ICE_TURN_USERNAME=
GV_ICE_TURN_CREDENTIAL=

# PostHog usage analytics (OPTIONAL — leave blank to disable all tracking)
# Both vars must be set at build time for analytics to activate. No events
# are sent and no external connections are opened when either is blank.
# Cloud (free tier): key from your project, host=https://us.i.posthog.com
# Self-hosted: key from your instance, host=https://analytics.your-domain.com
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
