# ── Production sc-web image ──────────────────────────────────────────
# Expects standalone Next.js output at ./sc-web-standalone/ in context.
# CI places it there; public/ dir comes from the repo directly.

FROM node:22-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Complete monorepo standalone output, including root node_modules and
# sc-web/server.js in the paths emitted by Next.js.
COPY sc-web-standalone/ ./

# Static assets served by Next.js (must be next to server.js in standalone)
COPY sc-web/public/ ./sc-web/public/

# Next.js build static assets (JS chunks, CSS) — not in standalone output
COPY sc-web-standalone/sc-web/.next/static/ ./sc-web/.next/static/

# Schema assets and isolated tooling used by the guarded empty-database initializer.
COPY sc-web/drizzle.config.ts ./sc-web/
COPY sc-web/drizzle/ ./sc-web/drizzle/
COPY sc-web/lib/db/schema.ts ./sc-web/lib/db/
WORKDIR /app/schema-tools
COPY docker/sc-web/schema-tools/package*.json ./
RUN npm ci --ignore-scripts && npm rebuild esbuild
WORKDIR /app

# Production entrypoint (guarded empty-DB initialization, then server startup)
COPY docker/sc-web/entrypoint.prod.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

EXPOSE 3000
CMD ["/entrypoint.sh"]
