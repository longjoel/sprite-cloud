{
  "id" : "com.spritecloud.SpriteCloud",
  "runtime" : "org.gnome.Platform",
  "runtime-version" : "48",
  "runtime-commit" : "0ebc10e5cc1fbe0836505fa203d75902606bcd4763c2c3cb0678795690dc506c",
  "sdk" : "org.gnome.Sdk",
  "sdk-commit" : "0fcaf52dcc423b664be691b4cba681c8de25849bbf231ca69da9e2b03605b42e",
  "command" : "sprite-cloud",
  "modules" : [
    {
      "name" : "sprite-cloud",
      "buildsystem" : "simple",
      "sources" : [
        {
          "path" : "..",
          "type" : "dir"
        }
      ],
      "build-options" : {
        "build-args" : [
          "--share=network"
        ]
      },
      "build-commands" : [
        "set -e\n. /usr/lib/sdk/rust-stable/enable.sh\ncargo build --release --manifest-path Cargo.toml --features app_debug\ninstall -Dm755 target/release/sc-desktop /app/bin/sprite-cloud\ninstall -Dm644 icons/32x32.png /app/share/icons/hicolor/32x32/apps/com.spritecloud.SpriteCloud.png\ninstall -Dm644 icons/128x128.png /app/share/icons/hicolor/128x128/apps/com.spritecloud.SpriteCloud.png\ninstall -Dm644 icons/128x128@2x.png /app/share/icons/hicolor/256x256/apps/com.spritecloud.SpriteCloud.png\ninstall -Dm644 flatpak/com.spritecloud.SpriteCloud.desktop /app/share/applications/com.spritecloud.SpriteCloud.desktop\ninstall -Dm644 flatpak/com.spritecloud.SpriteCloud.metainfo.xml /app/share/metainfo/com.spritecloud.SpriteCloud.metainfo.xml\n"
      ]
    }
  ],
  "sdk-extensions" : [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "finish-args" : [
    "--share=network",
    "--share=ipc",
    "--socket=wayland",
    "--socket=x11",
    "--socket=pulseaudio",
    "--device=dri",
    "--talk-name=org.freedesktop.secrets",
    "--env=GDK_BACKEND=x11",
    "--env=GSK_RENDERER=cairo"
  ],
  "source-date-epoch" : 1784652830
}