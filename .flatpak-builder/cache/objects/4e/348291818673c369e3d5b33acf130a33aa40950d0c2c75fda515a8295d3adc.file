[Application]
name=com.spritecloud.SpriteCloud
runtime=org.gnome.Platform/x86_64/48
sdk=org.gnome.Sdk/x86_64/48
command=sprite-cloud

[Context]
shared=network;ipc;
sockets=x11;wayland;pulseaudio;
devices=dri;

[Session Bus Policy]
org.freedesktop.secrets=talk

[Environment]
GSK_RENDERER=cairo
GDK_BACKEND=x11

[Extension com.spritecloud.SpriteCloud.Debug]
directory=lib/debug
autodelete=true
no-autodownload=true

[Build]
built-extensions=com.spritecloud.SpriteCloud.Debug;